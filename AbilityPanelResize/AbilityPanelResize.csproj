<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net472</TargetFramework>
        <AssemblyName>AbilityPanelResize</AssemblyName>
        <RootNamespace>AbilityPanelResize</RootNamespace>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <LangVersion>latest</LangVersion>
        <AssemblySearchPaths>$(WOTR_PATH)\Wrath_Data\Managed\;$(AssemblySearchPaths)</AssemblySearchPaths>

        <ResolveAssemblyReferenceIgnoreTargetFrameworkAttributeVersionMismatch>true</ResolveAssemblyReferenceIgnoreTargetFrameworkAttributeVersionMismatch>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="UnityModManager">
            <HintPath>$(WOTR_PATH)\Wrath_Data\Managed\UnityModManager\UnityModManager.dll</HintPath>
            <Private>False</Private>
        </Reference>

        <Reference Include="Assembly-CSharp">
            <HintPath>$(WOTR_PATH)\Wrath_Data\Managed\Assembly-CSharp.dll</HintPath>
            <Private>False</Private>
        </Reference>

        <Reference Include="UnityEngine">
            <HintPath>$(WOTR_PATH)\Wrath_Data\Managed\UnityEngine.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <HintPath>$(WOTR_PATH)\Wrath_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
            <Private>False</Private>
        </Reference>

        <!-- Берём именно копию из папки UnityModManager, а не ту, что лежит
             прямо в Managed - это та версия, которую UMM реально грузит в
             рантайм при старте, и на неё принято ссылаться остальным
             UMM-модам, чтобы не было расхождения версий Harmony между модами. -->
        <Reference Include="0Harmony">
            <HintPath>$(WOTR_PATH)\Wrath_Data\Managed\UnityModManager\0Harmony.dll</HintPath>
            <Private>False</Private>
        </Reference>

        <!-- ScrollRect, RectMask2D, GridLayoutGroup и остальные UI-типы -->
        <Reference Include="UnityEngine.UI">
            <HintPath>$(WOTR_PATH)\Wrath_Data\Managed\UnityEngine.UI.dll</HintPath>
            <Private>False</Private>
        </Reference>

        <!-- ViewBase<T> (базовый класс ActionBarGroupPCView) и остальной
             MVVM-фреймворк Owlcat живут здесь, не в Assembly-CSharp -->
        <Reference Include="Owlcat.Runtime.UI">
            <HintPath>$(WOTR_PATH)\Wrath_Data\Managed\Owlcat.Runtime.UI.dll</HintPath>
            <Private>False</Private>
        </Reference>

        <!-- TextAnchor (используется в GridLayoutGroup.childAlignment) -->
        <Reference Include="UnityEngine.TextRenderingModule">
            <HintPath>$(WOTR_PATH)\Wrath_Data\Managed\UnityEngine.TextRenderingModule.dll</HintPath>
            <Private>False</Private>
        </Reference>

        <!-- RectTransformUtility (используется в VerticalOnlyResizeHandle) -->
        <Reference Include="UnityEngine.UIModule">
            <HintPath>$(WOTR_PATH)\Wrath_Data\Managed\UnityEngine.UIModule.dll</HintPath>
            <Private>False</Private>
        </Reference>

        <!-- Input.GetMouseButtonUp (используется в ResizeElementAdapter) -->
        <Reference Include="UnityEngine.InputLegacyModule">
            <HintPath>$(WOTR_PATH)\Wrath_Data\Managed\UnityEngine.InputLegacyModule.dll</HintPath>
            <Private>False</Private>
        </Reference>

        <!-- GUILayout (используется в Main.OnGUI - вкладка настроек мода в UMM) -->
        <Reference Include="UnityEngine.IMGUIModule">
            <HintPath>$(WOTR_PATH)\Wrath_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
            <Private>False</Private>
        </Reference>
    </ItemGroup>

    <Target Name="DeployMod" AfterTargets="Build">
        <PropertyGroup>
            <ModFolder>$(WOTR_PATH)\Mods\$(AssemblyName)</ModFolder>
        </PropertyGroup>

        <Message Importance="High" Text="Начало деплоя мода в: $(ModFolder)" />

        <MakeDir Directories="$(ModFolder)" />

        <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(ModFolder)" />

        <Copy SourceFiles="Info.json" DestinationFolder="$(ModFolder)" />

        <Message Importance="High" Text="Мод успешно скопирован и готов к запуску!" />
    </Target>
</Project>